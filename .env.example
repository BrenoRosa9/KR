# Copie para .env e ajuste. O .env não vai para o Git.

KR_ENVIRONMENT=production
KR_DEBUG=false

# A senha aqui precisa bater com POSTGRES_PASSWORD abaixo.
KR_DATABASE_URL=postgresql+psycopg://kr:troque-esta-senha@db:5432/kr
POSTGRES_PASSWORD=troque-esta-senha

# Gere um valor novo: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar este segredo invalida todas as sessões abertas.
KR_SESSION_SECRET=troque-este-valor-em-producao
KR_SESSION_HOURS=12

KR_STORAGE_ROOT=/data
KR_MAX_UPLOAD_MB=200

KR_OCR_ENABLED=true
KR_OCR_LANGUAGE=por

# Camada de IA desligada por padrão. Ligar envia trechos de documentos de
# clientes para fora do servidor, o que é uma decisão de LGPD, não de engenharia.
KR_VISION_ENABLED=false
KR_VISION_PROVIDER=none
KR_VISION_API_KEY=
KR_VISION_MODEL=

KR_WORKER_POLL_SECONDS=2.0
KR_WORKER_MAX_ATTEMPTS=3

# Domínio servido pelo Caddy. Use o nome interno da máquina para HTTPS interno,
# ou um domínio público válido para certificado automático via Let's Encrypt.
SITE_ADDRESS=:80

# Só necessário em desenvolvimento (Vite em outra porta). Aceita JSON ou
# lista separada por vírgula. Em produção o Caddy serve API e UI na mesma origem.
# KR_CORS_ORIGINS=http://localhost:5173
